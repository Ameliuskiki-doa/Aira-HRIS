**/.DS_Store

**/.claude/settings.local.json

# Boundary-test fixtures. Written and removed by tests/boundary.test.ts; a run
# killed mid-test must not leave tracked files behind.
**/*.boundary-fixture.*
lib/domain/__boundary__/

