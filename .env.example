# Copy to .env.local and fill in. No real values belong in this file.
#
# NEVER put a Supabase service_role key here, or in any other env file in this
# repo. There is no code path that may use it: request paths carry the user JWT
# and the worker sets tenant context per transaction (AD-16).

# --- This deployment ---
# The canonical origin of this deployment. Not a secret; it is public by
# definition. It is also the ONLY thing that decides which host a confirmation
# link points at: `x-forwarded-host` was trusted here once, and a request
# carrying `X-Forwarded-Host: evil.example` made Supabase mail a confirmation
# link -- carrying the PKCE code -- to the attacker's host. A forwarded host is
# now honoured only when it matches this.
#
# Leave blank locally: it falls back to Vercel's own deployment host, then to
# http://localhost:3000 outside production. A production deployment that never
# sets it fails loudly rather than trusting whatever arrived.
NEXT_PUBLIC_SITE_URL=

# --- Supabase ---
# Project URL and the publishable key. Both are safe in the browser.
#
# `PUBLISHABLE`, not `ANON`: publishable is the name Supabase issues under now,
# and lib/supabase/keys.ts refuses anything that does not identify itself as
# one -- an `sb_publishable_...` key, or a legacy JWT carrying role "anon".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supavisor transaction-mode pooler. Used by serverless request paths (AD-4).
DATABASE_URL=

# Direct session connection. Used only by the long-lived worker (AD-4).
WORKER_DATABASE_URL=

# --- Cloudflare R2 (attendance photos) ---
# Server-held. Used only to mint short-TTL signed URLs (AD-20); bytes never
# pass through a route handler.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Sentry ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
