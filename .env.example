# Copy to .env.local and fill in. No real values belong in this file.
#
# NEVER put a Supabase service_role key here, or in any other env file in this
# repo. There is no code path that may use it: request paths carry the user JWT
# and the worker sets tenant context per transaction (AD-16).

# --- Supabase ---
# Project URL and the publishable (anon) key. Both are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supavisor transaction-mode pooler. Used by serverless request paths (AD-4).
DATABASE_URL=

# Direct session connection. Used only by the long-lived worker (AD-4).
WORKER_DATABASE_URL=

# --- Cloudflare R2 (attendance photos) ---
# Server-held. Used only to mint short-TTL signed URLs (AD-20); bytes never
# pass through a route handler.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Sentry ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
